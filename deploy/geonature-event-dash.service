[Unit]
Description=GeoNature Event Dash
After=network.target postgresql.service

[Service]
Type=simple
User=geonatureadmin
Group=geonatureadmin
WorkingDirectory=/home/geonatureadmin/GeoNature-Event-Dash
ExecStart=/home/geonatureadmin/GeoNature-Event-Dash/venv/bin/gunicorn dash_app:server \
    --bind 127.0.0.1:8050 \
    --workers 4 \
    --timeout 120 \
    --access-logfile - \
    --error-logfile -
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
